includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        - modules/

    level: 7

    # Sanctum types currentAccessToken() as always a PersonalAccessToken, but a session-authenticated
    # request yields a TransientToken, so the defensive instanceof checks must stay.
    treatPhpDocTypesAsCertain: false

    excludePaths:
        - modules/*/Tests/*

    # bootstrap/app.php runs before the configuration is loaded, so reading the environment there is the only way.
    ignoreErrors:
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: bootstrap/app.php
